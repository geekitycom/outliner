{
  "name": "@andrewshell/outliner",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "TypeScript port of Concord, Dave Winer / Small Picture's JavaScript outliner. Rewritten with no jQuery, no Bootstrap, and inline SVG icons instead of Font Awesome. GPL-3.0; derived from https://github.com/scripting/concord.",
  "keywords": [
    "outliner",
    "opml",
    "concord",
    "typescript",
    "editor"
  ],
  "homepage": "https://github.com/geekitycom/outliner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekitycom/outliner.git"
  },
  "bugs": {
    "url": "https://github.com/geekitycom/outliner/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/outliner.js",
  "module": "./dist/outliner.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/outliner.global.js",
  "jsdelivr": "./dist/outliner.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/outliner.js"
    },
    "./global": "./dist/outliner.global.js",
    "./compat-global": "./dist/outliner.compat.global.js",
    "./styles.css": "./dist/outliner.css"
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.compat.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --outDir dist-demo",
    "preview": "npm run build:demo && vite preview --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
